# Copy to benchmark.env and edit the paths / container name / GPU for your host.
# Never put an SSH private key or Hugging Face token here (this file is git-ignored).
# These values are read by ab_runner.sh when it runs on the server.

# Absolute path to the vllm-gr benchmark worktree on the host
PROJECT_DIR="${PROJECT_DIR:-/absolute/path/to/vllm-gr-benchmark-worktree}"
# Name of the benchmark container
CONTAINER_NAME="${CONTAINER_NAME:-vllm-gr-benchmark}"
# Host name shown in the report (label only)
HOST_NAME="${HOST_NAME:-L20}"
# Target GPU index
GPU_INDEX="${GPU_INDEX:-0}"

# Where PROJECT_DIR is mounted inside the container (usually unchanged)
CONTAINER_PROJECT_DIR="${CONTAINER_PROJECT_DIR:-/opt/vllm-gr}"
# OneRec dataset dir inside the container (verified by download_onerec_dataset.py)
CONTAINER_DATA_DIR="${CONTAINER_DATA_DIR:-/opt/vllm-gr/data}"
MODEL_ID="${MODEL_ID:-OpenOneRec/OneRec-1.7B}"
HF_ENDPOINT="${HF_ENDPOINT:-https://hf-mirror.com}"
# Constraint catalog triples JSON (container-side path). Empty = the runner
# stages the catalog committed under tools/AB_Tests/constraints/ and uses it.
CATALOG_PATH="${CATALOG_PATH:-}"

# Number of measured requests / warmup requests per side
NUM_PROMPTS="${NUM_PROMPTS:-100}"
WARMUP_REQUESTS="${WARMUP_REQUESTS:-10}"
# Beam entry point benchmarked on BOTH sides: v1 = EngineCore-owned
# beam_search_v1 (new default), legacy = GRLLM.beam_search(). Set legacy when
# the older of the two commits predates beam_search_v1 -- the base side cannot
# run a path it does not have. `ab_benchmark.sh --beam-api` overrides this.
BEAM_API="${BEAM_API:-v1}"
# Post-canonical phase-decomposition samples. Keep 0: AB measures E2E only,
# and these samples cost an extra request pair each. Turning it on collects a
# caliber the dashboard has stopped publishing (v4 here vs its v5), so use it
# to debug a local E2E regression only -- never as a trend point.
DIAGNOSTIC_PROMPTS="${DIAGNOSTIC_PROMPTS:-0}"
# Max used GPU memory (MiB) allowed before starting; the run is skipped if exceeded
GPU_IDLE_LIMIT_MIB="${GPU_IDLE_LIMIT_MIB:-1024}"
# Keep 0; the AB report only looks at canonical E2E data
LIGHTWEIGHT_TIMING="${LIGHTWEIGHT_TIMING:-0}"
# Extra engine env passed to BOTH benchmark sides (space-separated KEY=VALUE
# words). Only for gating behaviour the head commit turns on -- a base that
# predates the variable ignores it. Example:
# ENGINE_ENV="VLLM_GR_PREFILL_GRAPH_KV_BOUND=1024"
ENGINE_ENV="${ENGINE_ENV:-}"
